#!/usr/bin/env bash
# Installs HAProxy and distributes HTTP traffic between web-01 and web-02 using roundrobin
apt-get -y update
apt-get -y install haproxy
grep -q "^ENABLED=1" /etc/default/haproxy || echo "ENABLED=1" >> /etc/default/haproxy
cat > /etc/haproxy/haproxy.cfg <<'EOF'
global
    log /dev/log local0
    user haproxy
    group haproxy
    daemon

defaults
    log global
    mode http
    option httplog
    timeout connect 5000
    timeout client 50000
    timeout server 50000

frontend http_front
    bind *:80
    default_backend web_servers

backend web_servers
    balance roundrobin
    server web-01 172.26.0.20:80 check
    server web-02 172.26.0.12:80 check
EOF
service haproxy restart
